# Zkopíruj tento soubor jako .env.local a doplň vlastní hodnoty.
# Soubor .env.local se do gitu NEUKLÁDÁ (obsahuje tajné údaje).

# Tajný klíč pro podepisování přihlašovacích tokenů (JWT). POVINNÝ na produkci.
# Vygeneruj si náhodný řetězec, např.:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=zmen-me-na-dlouhy-nahodny-retezec

# Cesta k souboru databáze. Výchozí je ./poradna.db, v Dockeru /data/poradna.db
# DB_PATH=./poradna.db

# Veřejná adresa webu (pro SEO: sitemap, Open Graph, kanonické odkazy).
# Proměnné s prefixem NEXT_PUBLIC_ jsou vidět i v prohlížeči, nedávej do nich nic tajného!
# NEXT_PUBLIC_SITE_URL=https://poradna.example.cz
